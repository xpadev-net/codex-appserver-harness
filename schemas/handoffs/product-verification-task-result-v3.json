          "sha": {
            "maxLength": 16384,
            "type": "string"
          },
          "work_item_id": {
            "maxLength": 16384,
            "type": "string"
          }
        },
        "required": [
          "work_item_id",
          "candidate_id",
          "sha"
        ],
        "type": "object"
      },
      "maxItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "target",
    "phase_id",
    "task_id",
    "outcome",
    "artifacts",
    "criterion_results",
    "work_item_refs",
    "remaining",
    "blockers",
    "subscription_ids",
    "review",
    "verification",
    "product_changes",
    "product_verification"
  ],
  "type": "object"
}
