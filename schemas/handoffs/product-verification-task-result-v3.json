{
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "maxLength": 16384,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "blockers": {
      "items": {
        "maxLength": 16384,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "criterion_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "maxLength": 16384,
            "type": "string"
          },
          "criterion_id": {
            "maxLength": 16384,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 16384,
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "status": {
            "enum": [
              "claimed",
              "unverified"
            ],
            "maxLength": 16384,
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "evidence_ids",
          "status",
          "basis"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "outcome": {
      "enum": [
        "result",
        "waiting",
        "blocked"
      ],
      "maxLength": 16384,
      "type": "string"
    },
    "phase_id": {
      "maxLength": 16384,
      "type": "string"
    },
    "product_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "work_item_id": {
            "maxLength": 16384,
            "type": "string"
          },
          "workspace_digest": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "workspace_id": {
            "maxLength": 16384,
            "type": "string"
          }
        },
        "required": [
          "work_item_id",
          "workspace_id",
          "workspace_digest"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 0,
      "type": "array"
    },
    "product_verification": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "plan_artifact_id": {
              "maxLength": 16384,
              "type": "string"
            },
            "subject_digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "subject_id": {
              "maxLength": 16384,
              "type": "string"
            }
          },
          "required": [
            "subject_id",
            "subject_digest",
            "plan_artifact_id"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "remaining": {
      "items": {
        "maxLength": 16384,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "review": {
      "type": "null"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "subscription_ids": {
      "items": {
        "maxLength": 16384,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "plan_revision": {
          "type": "integer"
        },
        "policy_revision": {
          "type": "integer"
        },
        "scope_revision": {
          "type": "integer"
        },
        "wave_id": {
          "maxLength": 16384,
          "type": "string"
        }
      },
      "required": [
        "wave_id",
        "scope_revision",
        "plan_revision",
        "policy_revision"
      ],
      "type": "object"
    },
    "task_id": {
      "maxLength": 16384,
      "type": "string"
    },
    "verification": {
      "type": "null"
